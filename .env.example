# Contact form (api/contact.js). Set these in Vercel: Project, Settings, Environment Variables.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# Where enquiries are delivered (your custom inbox)
CONTACT_TO=hello@your-domain.com.au
# Sender shown on both emails. The domain must be verified in Resend (SPF and DKIM).
CONTACT_FROM=Theianex <hello@your-domain.com.au>
# Optional: link shown in the automatic reply
BOOKING_URL=https://cal.com/your-link

# Build-time (optional)
SITE_URL=https://www.your-domain.com.au
